# ============================================================
# Smart Home Docker Production Environment Variables (.env)
# ============================================================

# 1. IP SERVER BACKEND (Sangat Penting untuk OTA Firmware ESP32)
# Ganti 192.168.1.50 dengan IP LAN Home Server Anda (misal http://192.168.1.100:3000)
BACKEND_URL=http://192.168.1.50:3000

# 2. Database PostgreSQL
POSTGRES_USER=smarthome
POSTGRES_PASSWORD=smarthome_secret_password_change_me
POSTGRES_DB=smarthome_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://smarthome:smarthome_secret_password_change_me@postgres:5432/smarthome_db?schema=public

# 3. Application & Security (Port Mapping)
# Port host tempat web admin & backend diakses secara eksternal
WEB_ADMIN_PORT=8050
BACKEND_PORT=8051
NODE_ENV=production
JWT_SECRET=rahasia_jwt_super_aman_ganti_dengan_random_string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
DEVICE_OFFLINE_THRESHOLD_SECONDS=60

# 4. MQTT Broker (Internal Container)
MQTT_BROKER_URL=mqtt://mosquitto:1883
