# ============================================================
# Smart Home Backend - Environment Variables Example
# ============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env with real secrets.

# ----------------------------
# Application
# ----------------------------
PORT=3000
NODE_ENV=development

# The allowed origin(s) for CORS.
# For multiple origins, use a comma-separated list.
CORS_ORIGIN=http://localhost:5173

# Base URL for ESP node firmware binary download during OTA update
# Set this to the server IP or domain accessible by ESP devices on Wi-Fi (e.g. http://<SERVER_IP>:3000)
# BACKEND_URL=http://<SERVER_IP>:3000

# ----------------------------
# Database (PostgreSQL)
# ----------------------------
DATABASE_URL=postgresql://smarthome:changeme@localhost:5432/smarthome_db

# ----------------------------
# JWT Authentication
# ----------------------------
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ----------------------------
# MQTT (Mosquitto)
# ----------------------------
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ----------------------------
# Device Online/Offline Threshold
# ----------------------------
# Number of seconds without telemetry before a device is considered OFFLINE
DEVICE_OFFLINE_THRESHOLD_SECONDS=60
