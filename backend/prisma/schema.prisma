// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// USER
// ============================================================

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

// ============================================================
// HOME
// ============================================================

model Home {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms       Room[]
  automations Automation[]

  @@map("homes")
}

// ============================================================
// ROOM
// ============================================================

model Room {
  id        Int      @id @default(autoincrement())
  homeId    Int
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  home    Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  devices Device[]

  @@index([homeId])
  @@map("rooms")
}

// ============================================================
// DEVICE (Specialized into 4 concrete domains)
// ============================================================

enum DeviceType {
  TEMP_HUMIDITY
  SMART_DOOR
  SMART_CURTAIN
  EXHAUST_FAN
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

model Device {
  id          Int          @id @default(autoincrement())
  roomId      Int
  name        String
  deviceUid   String       @unique
  macAddress      String?      // Hardware MAC address for identity matching
  ipAddress       String?      // Local IP address of ESP node
  firmwareVersion String?      // Program / firmware version (e.g. 1.0.0)
  pairingCode     String?      // Secret pairing token/code for payload authentication
  deviceType      DeviceType   @default(TEMP_HUMIDITY)
  status          DeviceStatus @default(UNKNOWN)
  lastSeenAt      DateTime?
  metadata        Json?        // Holds live domain state & diagnostics snapshot
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  room                 Room                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  commands             DeviceCommand[]
  tempHumidityReadings TempHumidityReading[]
  firmwares            Firmware[]

  @@index([roomId])
  @@index([deviceUid])
  @@index([macAddress])
  @@index([pairingCode])
  @@index([lastSeenAt])
  @@map("devices")
}

// ============================================================
// FIRMWARE (OTA Binary & Version Management Table)
// ============================================================

enum FirmwareStatus {
  READY
  FLASHING
  ACTIVE
  FAILED
  PREVIOUS
  ARCHIVED
}

model Firmware {
  id          Int            @id @default(autoincrement())
  deviceId    Int
  version     String         // e.g. "1.0.1"
  fileName    String         // original file name e.g. "firmware_v1.0.1.bin"
  fileSize    Int            // in bytes
  fileData    Bytes?         // binary content stored in database
  checksum    String?        // SHA-256 hash for integrity verification
  changelog   String?        // Release notes / description
  isCurrent   Boolean        @default(false)
  uploadedAt  DateTime       @default(now())
  deployedAt  DateTime?      // timestamp when flashed/updated to ESP
  status      FirmwareStatus @default(READY)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([deviceId, isCurrent])
  @@index([uploadedAt])
  @@map("firmwares")
}

// ============================================================
// TEMPERATURE & HUMIDITY READINGS (Time-series telemetry table)
// ============================================================

model TempHumidityReading {
  id          Int      @id @default(autoincrement())
  deviceId    Int
  temperature Float
  humidity    Float
  recordedAt  DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([recordedAt])
  @@index([deviceId, recordedAt])
  @@map("temp_humidity_readings")
}

// ============================================================
// DEVICE COMMAND
// ============================================================

enum CommandStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  FAILED
}

model DeviceCommand {
  id         Int           @id @default(autoincrement())
  deviceId   Int
  command    String        // e.g. "set_speed", "lock", "unlock", "set_position"
  payload    Json?         // command-specific parameters
  status     CommandStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  executedAt DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([status])
  @@map("device_commands")
}

// ============================================================
// AUTOMATION
// ============================================================

model Automation {
  id            Int      @id @default(autoincrement())
  homeId        Int
  name          String
  enabled       Boolean  @default(true)
  configuration Json     // Automation rule configuration: trigger & action
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@index([homeId])
  @@map("automations")
}
