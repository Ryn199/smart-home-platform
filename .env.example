# ============================================================
# Smart Home Backend - Root Environment Variables Example
# ============================================================
# Copy this file to .env and fill in actual values before running docker-compose.
# NEVER commit .env with real secrets.

# ----------------------------
# Application Configuration
# ----------------------------
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ----------------------------
# PostgreSQL Configuration (Docker & Prisma)
# ----------------------------
POSTGRES_USER=smarthome
POSTGRES_PASSWORD=smarthome_secret
POSTGRES_DB=smarthome_db
POSTGRES_PORT=5432

# Connection string for NestJS / Prisma inside Docker:
DATABASE_URL=postgresql://smarthome:smarthome_secret@postgres:5432/smarthome_db?schema=public

# Connection string for local dev (outside Docker):
# DATABASE_URL=postgresql://smarthome:smarthome_secret@localhost:5432/smarthome_db?schema=public

# ----------------------------
# JWT Authentication
# ----------------------------
JWT_SECRET=change_this_to_a_secure_jwt_secret_key
JWT_EXPIRES_IN=7d

# ----------------------------
# MQTT Mosquitto Configuration
# ----------------------------
# Inside Docker container:
MQTT_BROKER_URL=mqtt://mosquitto:1883

# Outside Docker (local dev):
# MQTT_BROKER_URL=mqtt://localhost:1883

MQTT_USERNAME=
MQTT_PASSWORD=

# ----------------------------
# Device Monitoring Configuration
# ----------------------------
DEVICE_OFFLINE_THRESHOLD_SECONDS=60
